{
  "version": 3,
  "pages404": true,
  "appType": "app",
  "caseSensitive": false,
  "basePath": "",
  "redirects": [
    {
      "source": "/:path+/",
      "destination": "/:path+",
      "internal": true,
      "priority": true,
      "statusCode": 308,
      "regex": "^(?:/((?:[^/]+?)(?:/(?:[^/]+?))*))/$"
    },
    {
      "source": "/school",
      "destination": "/",
      "statusCode": 307,
      "regex": "^(?!/_next)/school(?:/)?$"
    },
    {
      "source": "/school/:path((?!_next|api|favicon\\.ico).*)",
      "destination": "/:path*",
      "statusCode": 307,
      "regex": "^(?!/_next)/school(?:/((?!_next|api|favicon\\.ico).*))(?:/)?$"
    }
  ],
  "headers": [],
  "onMatchHeaders": [],
  "rewrites": {
    "beforeFiles": [],
    "afterFiles": [
      {
        "source": "/school/_next/:path*",
        "destination": "/_next/:path*",
        "regex": "^/school/_next(?:/((?:[^/]+?)(?:/(?:[^/]+?))*))?(?:/)?$"
      },
      {
        "source": "/school/api/:path*",
        "destination": "/api/:path*",
        "regex": "^/school/api(?:/((?:[^/]+?)(?:/(?:[^/]+?))*))?(?:/)?$"
      },
      {
        "source": "/school/favicon.ico",
        "destination": "/favicon.ico",
        "regex": "^/school/favicon\\.ico(?:/)?$"
      }
    ],
    "fallback": []
  },
