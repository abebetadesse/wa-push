{
  "version": 3,
  "pages404": true,
  "appType": "app",
  "caseSensitive": false,
  "basePath": "/school",
  "redirects": [
    {
      "source": "/school/",
      "destination": "/school",
      "basePath": false,
      "internal": true,
      "priority": true,
      "statusCode": 308,
      "regex": "^/school/$"
    },
    {
      "source": "/:path+/",
      "destination": "/:path+",
      "internal": true,
      "priority": true,
      "statusCode": 308,
      "regex": "^(?:/((?:[^/]+?)(?:/(?:[^/]+?))*))/$"
    }
  ],
  "headers": [],
  "onMatchHeaders": [],
  "rewrites": {
    "beforeFiles": [],
    "afterFiles": [],
    "fallback": []
  },
  "dynamicRoutes": [
    {
      "page": "/api/auth/[...all]",
      "regex": "^/api/auth/(.+?)(?:/)?$",
      "routeKeys": {
        "nxtPall": "nxtPall"
      },
      "namedRegex": "^/api/auth/(?<nxtPall>.+?)(?:/)?$"
    },
    {
      "page": "/api/resources/[id]",
      "regex": "^/api/resources/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPid": "nxtPid"
      },
      "namedRegex": "^/api/resources/(?<nxtPid>[^/]+?)(?:/)?$"
    },
    {
      "page": "/lessons/[id]",
      "regex": "^/lessons/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPid": "nxtPid"
      },
      "namedRegex": "^/lessons/(?<nxtPid>[^/]+?)(?:/)?$",
      "prefetchSegmentDataRoutes": [
        {
          "destination": "/lessons/[id].segments/lessons/$d$id$segment",
          "source": "^/lessons/(?<nxtPid>[^/]+?)\\.segments/lessons/\\$d\\$id(?<segment>/__PAGE__\\.segment\\.rsc|\\.segment\\.rsc)(?:/)?$",
          "routeKeys": {
            "nxtPid": "nxtPid"
          }
        }
      ]
    },
    {
      "page": "/students/[id]",
      "regex": "^/students/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPid": "nxtPid"
      },
      "namedRegex": "^/students/(?<nxtPid>[^/]+?)(?:/)?$",
      "prefetchSegmentDataRoutes": [
        {
          "destination": "/students/[id].segments/students/$d$id$segment",
          "source": "^/students/(?<nxtPid>[^/]+?)\\.segments/students/\\$d\\$id(?<segment>/__PAGE__\\.segment\\.rsc|\\.segment\\.rsc)(?:/)?$",
          "routeKeys": {
            "nxtPid": "nxtPid"
          }
        }
      ]
    },
    {
      "page": "/teachers/[id]",
      "regex": "^/teachers/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPid": "nxtPid"
      },
      "namedRegex": "^/teachers/(?<nxtPid>[^/]+?)(?:/)?$",
      "prefetchSegmentDataRoutes": [
        {
          "destination": "/teachers/[id].segments/teachers/$d$id$segment",
          "source": "^/teachers/(?<nxtPid>[^/]+?)\\.segments/teachers/\\$d\\$id(?<segment>/__PAGE__\\.segment\\.rsc|\\.segment\\.rsc)(?:/)?$",
          "routeKeys": {
            "nxtPid": "nxtPid"
          }
        }
      ]
    }
  ],
