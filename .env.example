DATABASE_URL=mysql://forma_app:replace-with-a-strong-local-app-password@127.0.0.1:3306/forma
MYSQL_ROOT_PASSWORD=replace-with-a-strong-local-root-password
MYSQL_PASSWORD=replace-with-a-strong-local-app-password
BETTER_AUTH_SECRET=generate-a-unique-secret-with-at-least-32-characters
BETTER_AUTH_URL=http://localhost:3000
# Path prefix only when served under another site, e.g. /school. Build-time; empty for its own domain.
# BETTER_AUTH_URL stays the origin without the prefix. npm run deploy:plesk sets this for you.
NEXT_PUBLIC_BASE_PATH=
UPLOAD_DIR=./var/uploads
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM="Forma <noreply@example.com>"
# AI Studio (Claude). Leave empty to turn AI generation off. Create a key at https://platform.claude.com.
ANTHROPIC_API_KEY=
# Hosts textbooks may be downloaded from, comma-separated. Empty uses the official default list.
TEXTBOOK_SOURCE_HOSTS=
